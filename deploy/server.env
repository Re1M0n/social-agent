# ─────────────────────────────────────────────────────────────
# Configuración para el TEST en un servidor dedicado.
# Copia a ~/apps/social-agent/.env (ver deploy/README-servidor.md).
# DRY_RUN=1 → simulación: nada se publica de verdad.
# ─────────────────────────────────────────────────────────────
DRY_RUN=1
AUTO_PUBLISH=0
MIN_POST_INTERVAL_MINUTES=60

# LLM local con Ollama (modelos en /mnt/storage/ollama).
# En hardware potente (GPU NVIDIA ≥ 8 GB VRAM o ≥ 16 GB RAM) llama3.1:8b va
# bien; con más recursos sube a qwen2.5:14b o llama3.3:70b-q4_0.
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b

# Todos los canales habilitados para probar el pipeline completo en seco.
CHANNEL_MASTODON_ENABLED=1
CHANNEL_BLUESKY_ENABLED=1
CHANNEL_TWITTER_ENABLED=1
CHANNEL_LINKEDIN_ENABLED=1
CHANNEL_INSTAGRAM_ENABLED=1
CHANNEL_FACEBOOK_ENABLED=1
CHANNEL_TIKTOK_ENABLED=1
