[TEMPLATE]
# ─────────────────────────────────────────────────────────────
# Social Agent — configuración
# Copia este archivo a .env y rellena lo que necesites.
# ─────────────────────────────────────────────────────────────

# ── Modo de ejecución ────────────────────────────────────────
# DRY_RUN=1 (por defecto) = simulación: nada se publica de verdad.
# Pon DRY_RUN=0 cuando estés listo para publicar en vivo.
DRY_RUN=1

# AUTO_PUBLISH=1 → el agente programa y publica solo (modo autónomo).
# AUTO_PUBLISH=0 → los drafts quedan para revisión humana.
AUTO_PUBLISH=0

# Intervalo mínimo entre publicaciones (minutos). Evita spam.
MIN_POST_INTERVAL_MINUTES=60

# ── LLM (agente experto) — TODO GRATIS, sin tarjeta ──────────
# El agente SE COMUNICA CON LA IA por defecto, sin configuración:
# sin LLM_API_KEY usa el proveedor gratuito anónimo (Kilo Code, sin registro)
# y, si falla, cae automáticamente a plantillas. Comprueba el estado con:
#   npm run llm:check
#
# Para una IA más rápida y estable, crea una key gratis (5 min, sin tarjeta)
# y ponla abajo. Compatible con cualquier API estilo OpenAI:
#
#   Groq (recomendada: muy rápida, sin tarjeta):
#     LLM_API_KEY=gsk_…             (console.groq.com)
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=llama-3.3-70b-versatile
#
#   OpenRouter (20+ modelos :free, sin tarjeta):
#     LLM_API_KEY=sk-or-v1-…        (openrouter.ai)
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#     LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
#   Google Gemini (AI Studio, sin tarjeta):
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_MODEL=gemini-2.0-flash
#
#   Ollama LOCAL (privado, ~5 GB de disco con llama3.1:8b):
#     LLM_API_KEY=ollama
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODEL=llama3.1:8b          (ollama pull llama3.1:8b)
#
# LLM_FREE_FALLBACK=0 → sin key, el agente usa solo plantillas (sin llamadas externas).
# LLM_ENABLED=0       → fuerza plantillas incluso con key.
# Espacio en disco: análisis completo en docs/llm-disk-space.md.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_FREE_FALLBACK=1

# ── IA local/remota (Ollama, LM Studio, Qwen) — automática ───
# LLM_LOCAL=auto (por defecto) detecta una IA local sin configurar nada:
#   Ollama en http://localhost:11434 o LM Studio en http://localhost:1234,
#   y usa el mejor modelo disponible (Qwen, Llama, Gemma, Mistral, DeepSeek…).
# ¿Tienes Qwen en OTRA máquina? Apunta a ella y listo:
#   OLLAMA_BASE_URL=http://192.168.1.50:11434   (host de esa máquina)
#   OLLAMA_MODEL=qwen2.5:7b                     (opcional: si no, elige el mejor)
# LLM_LOCAL=1 → fuerza la IA local (avisa si no responde).
# LLM_LOCAL=0 → desactiva la detección (configuración manual con LLM_BASE_URL/LLM_MODEL).
# Con LLM_API_KEY configurada, la detección se ignora: manda tu proveedor.
LLM_LOCAL=auto
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# ── Selector de potencia/velocidad (cuidar el hardware) ──────
# Solo afecta a Ollama (local o remota, p. ej. tu máquina con Qwen).
# LLM_SPEED=ahorro      → menos RAM/VRAM/CPU y menos calor: contexto corto
#                         (6144), tope de salida 2048, mitad de CPUs y el
#                         modelo se descarga de memoria a los 5 min de inactivo.
# LLM_SPEED=equilibrado → por defecto: contexto 8192, salida 3072, descarga a
#                         los 30 min.
# LLM_SPEED=rendimiento → máxima velocidad: contexto 16384, salida 4096, el
#                         modelo queda siempre cargado en memoria.
# Además, en modo ahorro se elige el modelo más pequeño disponible y en
# rendimiento el más grande (p. ej. qwen2.5:3b frente a qwen2.5:14b).
LLM_SPEED=equilibrado

# ── Imagen gratuita (comando gen-image) ──────────────────────
# Sin clave usa Pollinations (gratis, sin registro, ilimitado).
# Con HF_TOKEN usa Hugging Face (FLUX.1-schnell, gratis sin tarjeta,
# créditos mensuales): https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Contenido y datos ────────────────────────────────────────
# CONTENT_DIR=content        (carpeta raíz de contenido)
# IDEAS_DIR=content/ideas    (ideas base en .md/.txt)
# MEDIA_DIR=content/media    (fotos y videos)
# DATA_FILE=data/agent.json  (estado persistente)

# ── Media pública (Instagram y TikTok) ───────────────────────
# La media debe ser accesible por URL pública. Dos opciones:
#   Local  : npm run serve:media  → http://localhost:8787 (solo pruebas)
#   Pública: ngrok, VPS, CDN… (Instagram/TikTok descargan la media desde aquí)
# PUBLIC_MEDIA_BASE_URL se usa para Instagram y TikTok si no defines las
# específicas de cada canal.
PUBLIC_MEDIA_BASE_URL=

# ── Canales: Mastodon ────────────────────────────────────────
# URL de tu instancia (ej: https://mastodon.social) y token de acceso
# (Preferencias → Desarrollo → Nueva aplicación).
MASTODON_URL=
MASTODON_TOKEN=

# ── Canales: Bluesky ─────────────────────────────────────────
# Tu handle (ej: usuario.bsky.social) y "app password" generada en
# Configuración → App Passwords.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# ── Canales: X / Twitter ─────────────────────────────────────
# Developer Portal → Proyecto → Keys and tokens (OAuth 1.0a).
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ── Canales: LinkedIn ────────────────────────────────────────
# Token OAuth2 con scope w_member_social. Opcional: ID de organización
# si publicas como empresa (si no, usa el perfil del usuario).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=

# ── Canales: Instagram ───────────────────────────────────────
# Token de página de Meta (Graph API, scope instagram_basic,
# instagram_content_publish) e ID de cuenta de Instagram.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Opcional: si no usas PUBLIC_MEDIA_BASE_URL, define la base específica:
INSTAGRAM_MEDIA_BASE_URL=

# ── Canales: Facebook ────────────────────────────────────────
# Token de página (scope pages_manage_posts) e ID de página.
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# ── Canales: TikTok ──────────────────────────────────────────
# Token OAuth2 de la Content Posting API y open_id del usuario.
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
# Opcional: si no usas PUBLIC_MEDIA_BASE_URL, define la base específica:
TIKTOK_MEDIA_BASE_URL=
